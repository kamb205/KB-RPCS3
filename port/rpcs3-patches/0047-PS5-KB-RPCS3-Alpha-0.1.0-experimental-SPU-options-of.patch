+	bool ps5_try_narrow_store(llvm::Value* rt, u32 kind, llvm::Value* ra, llvm::Value* rb, s64 imm, llvm::Value* addr)
+	{
+		if (!m_ps5_narrow_ls_store || m_interp_magn)
+			return false;
+		auto it = m_ps5_ins.find(rt);
+		if (it == m_ps5_ins.end() || it->second.epoch != m_ps5_epoch)
+			return false;
+		const ps5_ins_t ins = it->second;
+		auto lit = m_ps5_ld.find(ins.base);
+		if (lit == m_ps5_ld.end() || lit->second.epoch != m_ps5_epoch)
