+
+// Combo §3: affinity only — move the busiest SPU thread (>= 85 %) to CPU <cpu>, the one CPU without an SMT
+// sibling, and take that CPU away from every other thread whose normal mask has it. No effect on emulation.
+static thread_class ps5_class_of(const std::string& n)
+{
+	if (n.rfind("SPU", 0) == 0)
+		return thread_class::spu;
+	if (n.rfind("rsx", 0) == 0 || n.rfind("RSX", 0) == 0)
+		return thread_class::rsx;
+	return thread_class::ppu;
+}
+
+namespace
+{
+	bool g_ps5_hot_active = false;
+	pthread_t g_ps5_hot_pinned{};
+	std::string g_ps5_hot_pinned_name;
+	std::string g_ps5_hot_cand_name;
+	int g_ps5_hot_cand_streak = 0;
+	bool g_ps5_hot_conflict_logged = false;
+	// What the last applied pass pinned / how many threads it saw (g_ps5_threads_mutex)
+	pthread_t g_ps5_hot_applied_pinned{};
+	usz g_ps5_hot_applied_count = 0;
+}
+
+static void ps5_apply_mask(pthread_t thread, u64 mask)
+{
+	cpu_set_t cs;
+	CPU_ZERO(&cs);
+	for (u32 c = 0; c < 64u; c++)
+	{
+		const u64 shifted = mask >> c;
+		if (shifted & 1)
+		{
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wold-style-cast"
+			CPU_SET(c, &cs);
+#pragma GCC diagnostic pop
+		}
+		if (shifted <= 1)
+			break;
+	}
+	::pthread_setaffinity_np(thread, sizeof(cpu_set_t), &cs);
+}
+
+extern "C" void ps5_hot_spu_rebalance(s64 cpu)
+{
+	const u64 pmask = thread_ctrl::get_process_affinity_mask();
+
+	if (cpu < 0 || cpu >= 64 || !(pmask >> cpu & 1) || g_cfg.core.thread_scheduler == thread_scheduler_mode::os)
+	{
+		if (g_ps5_hot_active)
+		{
+			std::lock_guard lock(g_ps5_threads_mutex);
+			for (auto& e : g_ps5_threads)
+				ps5_apply_mask(e.thread, ps5_affinity_mask(ps5_class_of(*e.name->load()), pmask));
+			g_ps5_hot_active = false;
+			g_ps5_hot_applied_pinned = {};
+			g_ps5_hot_applied_count = 0;
+			sig_log.notice("PS5 HOTCPU: off, masks restored");
+		}
+		return;
+	}
+
+	// Snapshot and apply under one lock: thread entries are removed under g_ps5_threads_mutex before a thread
+	// exits (thread_base::finalize), so no pthread_t of an exited thread can be used here.
+	std::lock_guard lock(g_ps5_threads_mutex);
+
+	struct row { pthread_t t; std::string name; u32 pct; thread_class cls; };
+	std::vector<row> rows;
+	for (auto& e : g_ps5_threads)
+	{
+		const std::string n = *e.name->load();
+		rows.push_back({e.thread, n, e.last_pct, ps5_class_of(n)});
+	}
+
+	// SPU execution threads only ("SPU[0x...]"); not "SPU Worker" or other helpers.
+	const row* best = nullptr;
+	for (const auto& r : rows)
+		if (r.cls == thread_class::spu && r.name.compare(0, 4, "SPU[") == 0 && (!best || r.pct > best->pct))
+			best = &r;
+
+	if (!g_ps5_hot_active)
+	{
+		if (!best || best->pct < 85)
+			return;
+		g_ps5_hot_active = true;
+		g_ps5_hot_pinned = best->t;
+		g_ps5_hot_pinned_name = best->name;
+		sig_log.notice("PS5 HOTCPU: %s -> CPU %d (%u%%)", best->name, static_cast<int>(cpu), best->pct);
+	}
+	else
+	{
+		bool found = false;
+		u32 pinned_pct = 0;
+		for (const auto& r : rows)
+			if (r.t == g_ps5_hot_pinned) { found = true; pinned_pct = r.pct; }
+		if (!found)
+		{
+			g_ps5_hot_active = false;
+			g_ps5_hot_cand_streak = 0;
+			g_ps5_hot_cand_name.clear();
+			g_ps5_hot_applied_pinned = {};
+			g_ps5_hot_applied_count = 0;
+			return;
+		}
+		if (best && best->name != g_ps5_hot_pinned_name && best->pct >= 85 && best->pct >= pinned_pct + 10)
+		{
+			if (g_ps5_hot_cand_name == best->name)
+				g_ps5_hot_cand_streak++;
+			else
+			{
+				g_ps5_hot_cand_name = best->name;
+				g_ps5_hot_cand_streak = 1;
+			}
+			if (g_ps5_hot_cand_streak >= 2)
+			{
+				g_ps5_hot_pinned = best->t;
+				g_ps5_hot_pinned_name = best->name;
+				g_ps5_hot_cand_streak = 0;
+				g_ps5_hot_cand_name.clear();
+				sig_log.notice("PS5 HOTCPU: %s -> CPU %d (%u%%)", best->name, static_cast<int>(cpu), best->pct);
+			}
+		}
+		else
+		{
+			g_ps5_hot_cand_streak = 0;
+		}
+	}
+
+	if (cpu == rpcs3ps5_tune(PS5_TUNE_RSX_CPU) && !g_ps5_hot_conflict_logged)
+	{
+		g_ps5_hot_conflict_logged = true;
+		sig_log.notice("PS5 HOTCPU: rsx_cpu == spu_hot_cpu; spu_hot_cpu wins for CPU %d", static_cast<int>(cpu));
+	}
+
+	// Re-apply only when the pinned thread or the registered thread count changed; otherwise the masks are
+	// already in force and re-applying every 4 s only fights the OS.
+	if (g_ps5_hot_applied_pinned == g_ps5_hot_pinned && g_ps5_hot_applied_count == rows.size())
+		return;
+
+	for (const auto& r : rows)
+	{
+		const u64 normal = ps5_affinity_mask(r.cls, pmask);
+		if (r.t == g_ps5_hot_pinned)
+			ps5_apply_mask(r.t, 1ull << cpu);
+		else if (normal >> cpu & 1)
+			ps5_apply_mask(r.t, normal & ~(1ull << cpu));
+		else
+			ps5_apply_mask(r.t, normal);
+	}
+	g_ps5_hot_applied_pinned = g_ps5_hot_pinned;
+	g_ps5_hot_applied_count = rows.size();
+}
 #endif
 
