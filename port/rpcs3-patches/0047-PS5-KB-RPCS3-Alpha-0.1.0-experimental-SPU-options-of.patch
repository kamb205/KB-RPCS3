 rpcs3/Emu/Cell/SPULLVMRecompiler.cpp | 301 +++++++++++++++++++++++++++
 rpcs3/ps5/ps5_frontend.cpp           |  30 +++
 5 files changed, 501 insertions(+), 2 deletions(-)

