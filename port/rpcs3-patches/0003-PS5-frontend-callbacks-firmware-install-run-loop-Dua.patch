+
+#include <cstdlib>
+#include <deque>
+#include <mutex>
+#include <thread>
+
+LOG_CHANNEL(sys_log, "SYS");
+
+namespace
+{
+rpcs3ps5_host g_host{};
+std::string g_error;
+std::string g_firmware;
+std::unique_ptr<logs::listener> g_log_file;
+
+std::mutex g_main_mutex;
+std::deque<std::pair<std::function<void()>, atomic_t<u32>*>> g_main_queue;
+
+void host_log(const std::string& line)
+{
+	if (g_host.log)
+		g_host.log(line.c_str());
+}
+
+void host_progress(const std::string& text)
+{
+	if (g_host.progress)
+		g_host.progress(text.c_str());
+}
+
+int fail(std::string text)
+{
+	g_error = std::move(text);
+	sys_log.error("PS5: %s", g_error);
+	host_log("rpcs3: error: " + g_error);
+	return -1;
+}
+
+// Runs what RPCS3 asked the main thread to do
+void pump_main_thread()
+{
+	for (;;)
+	{
+		std::pair<std::function<void()>, atomic_t<u32>*> item;
+		{
+			std::lock_guard lock(g_main_mutex);
+			if (g_main_queue.empty())
+				return;
+			item = std::move(g_main_queue.front());
+			g_main_queue.pop_front();
+		}
+		item.first();
+		if (item.second)
+		{
+			*item.second = true;
+			item.second->notify_one();
+		}
+	}
+}
+
+// Warnings and worse reach the title's log as they happen; everything goes to RPCS3.log
+struct host_listener final : logs::listener
+{
+	void log(u64 /*stamp*/, const logs::message& msg, std::string_view prefix, std::string_view text) override
+	{
+		if (msg <= logs::level::warning)
+		{
+			std::string line = "rpcs3: ";
+			line += prefix;
+			line += text;
+			host_log(line);
+		}
+	}
+};
+
+void create_callbacks()
+{
+	EmuCallbacks callbacks{};
+
+	callbacks.call_from_main_thread = [](std::function<void()> func, atomic_t<u32>* wake_up)
+	{
+		std::lock_guard lock(g_main_mutex);
+		g_main_queue.emplace_back(std::move(func), wake_up);
+	};
+	callbacks.try_to_quit = [](bool force_quit, std::function<void()> on_exit) -> bool
+	{
+		if (force_quit && on_exit)
+			on_exit();
+		return force_quit;
+	};
+	callbacks.init_gs_render = [](utils::serial* ar)
+	{
+		switch (const video_renderer type = g_cfg.video.renderer)
+		{
+		case video_renderer::null:
+			g_fxo->init<rsx::thread, named_thread<NullGSRender>>(ar);
+			break;
+		case video_renderer::vulkan:
+			g_fxo->init<rsx::thread, named_thread<VKGSRender>>(ar);
+			break;
+		default:
+			fmt::throw_exception("PS5: unsupported video renderer %s", type);
+		}
+	};
+	callbacks.get_gs_frame = []() -> std::unique_ptr<GSFrameBase> { return std::make_unique<ps5_gs_frame>(); };
+	callbacks.close_gs_frame = []() {};
+	callbacks.get_audio = []() -> std::shared_ptr<AudioBackend> { return std::make_shared<NullAudioBackend>(); };
+	callbacks.get_audio_enumerator = [](u64) -> std::shared_ptr<audio_device_enumerator> { return std::make_shared<null_enumerator>(); };
+	callbacks.init_kb_handler = []() { ensure(g_fxo->init<KeyboardHandlerBase, NullKeyboardHandler>(Emu.DeserialManager())); };
+	callbacks.init_mouse_handler = []() { ensure(g_fxo->init<MouseHandlerBase, NullMouseHandler>(Emu.DeserialManager())); };
+	callbacks.init_pad_handler = [](std::string_view title_id)
+	{
+		ensure(g_fxo->init<named_thread<pad_thread>>(nullptr, nullptr, title_id));
+	};
+	callbacks.get_camera_handler = []() -> std::shared_ptr<camera_handler_base> { return std::make_shared<null_camera_handler>(); };
+	callbacks.get_music_handler = []() -> std::shared_ptr<music_handler_base> { return std::make_shared<null_music_handler>(); };
+	callbacks.update_emu_settings = []() {};
+	callbacks.save_emu_settings = []() { Emulator::SaveSettings(g_cfg.to_string(), Emu.GetTitleID()); };
+
+	callbacks.get_msg_dialog = []() -> std::shared_ptr<MsgDialogBase> { return {}; };
+	callbacks.get_osk_dialog = []() -> std::shared_ptr<OskDialogBase> { return {}; };
+	callbacks.get_save_dialog = []() -> std::unique_ptr<SaveDialogBase> { return {}; };
+	callbacks.get_sendmessage_dialog = []() -> std::shared_ptr<SendMessageDialogBase> { return {}; };
+	callbacks.get_recvmessage_dialog = []() -> std::shared_ptr<RecvMessageDialogBase> { return {}; };
+	callbacks.get_trophy_notification_dialog = []() -> std::unique_ptr<TrophyNotificationBase> { return {}; };
+
+	callbacks.on_run = [](bool) {};
+	callbacks.on_pause = []() {};
+	callbacks.on_resume = []() {};
+	callbacks.on_stop = []() {};
+	callbacks.on_ready = []() {};
+	callbacks.on_missing_fw = []() { host_progress("PS3 system software is missing: install PS3UPDAT.PUP first"); };
+	callbacks.on_emulation_stop_no_response = [](std::shared_ptr<atomic_t<bool>>, int) {};
+	callbacks.on_save_state_progress = [](std::shared_ptr<atomic_t<bool>>, stx::shared_ptr<utils::serial>, stx::atomic_ptr<std::string>*, std::shared_ptr<void>) {};
+	callbacks.enable_disc_eject = [](bool) {};
+	callbacks.enable_disc_insert = [](bool) {};
+	callbacks.handle_taskbar_progress = [](s32, s32) {};
+	callbacks.get_localized_string = [](localized_string_id, const char*) -> std::string { return {}; };
+	callbacks.get_localized_u32string = [](localized_string_id, const char*) -> std::u32string { return {}; };
+	callbacks.get_localized_setting = [](const cfg::_base*, u32) -> std::string { return {}; };
+	callbacks.play_sound = [](const std::string&, std::optional<f32>) {};
+	callbacks.add_breakpoint = [](u32) {};
+	callbacks.display_sleep_control_supported = []() { return false; };
+	callbacks.enable_display_sleep = [](bool) {};
+	callbacks.check_microphone_permissions = []() {};
+	callbacks.make_video_source = []() { return nullptr; };
+	callbacks.enable_gamemode = [](bool) {};
+	callbacks.get_font_dirs = []() { return std::vector<std::string>{}; };
+	callbacks.on_install_pkgs = [](const std::vector<std::string>&, bool) { return false; };
+	callbacks.get_image_info = [](const std::string&, std::string&, s32&, s32&, s32&) { return false; };
+	callbacks.get_scaled_image = [](const std::string&, s32, s32, s32&, s32&, u8*, bool) { return false; };
+	callbacks.get_photo_path = [](std::string_view) { return std::string{}; };
+	callbacks.get_database_config = [](const std::string&) { return std::string{}; };
+
+	Emu.SetCallbacks(std::move(callbacks));
+}
+
+// The defaults a console without a settings screen needs
+void apply_defaults()
+{
+	g_cfg.video.renderer.set(video_renderer::vulkan);
+	g_cfg.audio.renderer.set(audio_renderer::null);
+	g_cfg.core.ppu_decoder.set(ppu_decoder_type::llvm);
+	g_cfg.core.spu_decoder.set(spu_decoder_type::llvm);
+}
+} // namespace
+
+void rpcs3ps5_read_host_pad(rpcs3ps5_pad* pad)
+{
+	if (g_host.read_pad)
+		g_host.read_pad(pad);
+	else
+		*pad = {};
+}
+
+// rpcs3.cpp's, which the PS5 build does not have
+[[noreturn]] void report_fatal_error(std::string_view text, bool /*is_html*/ = false, bool /*include_help_text*/ = true)
+{
+	host_log(fmt::format("rpcs3: FATAL: %s", text));
+	std::fprintf(stderr, "RPCS3 FATAL: %.*s\n", static_cast<int>(text.size()), text.data());
+	std::fflush(stderr);
+	std::abort();
+}
+
+extern "C" int rpcs3ps5_init(const char* root, const rpcs3ps5_host* host)
+{
+	if (host)
+		g_host = *host;
+
+	// fs::get_config_dir() and get_cache_dir() read these: <root>/rpcs3/
+	::setenv("XDG_CONFIG_HOME", root, 1);
+	::setenv("XDG_CACHE_HOME", root, 1);
+	::setenv("HOME", root, 1);
+
+	// Initialize thread pool finalizer (on first use), as rpcs3.cpp does
+	static_cast<void>(named_thread("", [](int) {}));
+
+	g_log_file = logs::make_file_listener(fs::get_cache_dir() + "RPCS3.log", 64 * 1024 * 1024);
+	static host_listener listener;
+	logs::listener::add(&listener);
+	sys_log.always()("RPCS3 PS5 frontend: config %s", fs::get_config_dir());
+
+	create_callbacks();
+	Emu.SetHasGui(false);
+	Emu.SetHeadless(false);
+	Emu.SetUsr("00000001");
+	Emu.Init();
+	apply_defaults();
+
+	g_firmware = utils::get_firmware_version();
+	sys_log.always()("%s", g_firmware.empty() ? "Missing Firmware" : "Firmware version: " + g_firmware);
+	host_log("rpcs3: initialised; firmware " + (g_firmware.empty() ? std::string("missing") : g_firmware));
+	return 0;
+}
+
+extern "C" const char* rpcs3ps5_firmware_version(void)
+{
+	g_firmware = utils::get_firmware_version();
+	return g_firmware.c_str();
+}
+
+extern "C" const char* rpcs3ps5_error(void)
+{
+	return g_error.c_str();
+}
+
+extern "C" int rpcs3ps5_install_firmware(const char* pup_path)
+{
+	fs::file pup_f(pup_path);
+	if (!pup_f)
+		return fail(fmt::format("cannot open %s (%s)", pup_path, fs::g_tls_error));
+
+	host_progress("Checking PS3UPDAT.PUP...");
+	pup_object pup(std::move(pup_f));
+	if (pup.operator pup_error() != pup_error::ok)
+		return fail("PS3UPDAT.PUP is not a valid PS3 update: " + pup.get_formatted_error());
+
+	fs::file update_files_f = pup.get_file(0x300);
+	if (!update_files_f || !update_files_f.size())
+		return fail("PS3UPDAT.PUP holds no installation packages");
+
+	tar_object update_files(update_files_f);
+	auto update_filenames = update_files.get_filenames();
+	std::erase_if(update_filenames, [](const std::string& s) { return s.find("dev_flash_") == umax; });
+	if (update_filenames.empty())
+		return fail("PS3UPDAT.PUP holds no dev_flash packages");
+
+	std::string version_string;
+	if (fs::file version = pup.get_file(0x100))
+		version_string = version.to_string();
+	if (const usz pos = version_string.find('\n'); pos != umax)
+		version_string.erase(pos);
+
+	// tar_object::extract() writes under the mounted /dev_flash
+	vfs::mount("/dev_flash", g_cfg_vfs.get_dev_flash());
+
+	usz done = 0;
+	for (const auto& update_filename : update_filenames)
+	{
+		host_progress(fmt::format("Installing PS3 system software %s: %u of %u", version_string, done + 1, update_filenames.size()));
+		auto update_file_stream = update_files.get_file(update_filename);
+		if (update_file_stream->m_file_handler)
+			update_file_stream->m_file_handler->handle_file_op(*update_file_stream, 0, update_file_stream->get_size(umax), nullptr);
+
+		fs::file update_file = fs::make_stream(std::move(update_file_stream->data));
+		SCEDecrypter self_dec(update_file);
+		self_dec.LoadHeaders();
+		self_dec.LoadMetadata(SCEPKG_ERK, SCEPKG_RIV);
+		self_dec.DecryptData();
+
+		auto dev_flash_tar_f = self_dec.MakeFile();
+		if (dev_flash_tar_f.size() < 3)
+			return fail("firmware package " + update_filename + " could not be decrypted");
+
+		tar_object dev_flash_tar(dev_flash_tar_f[2]);
+		if (!dev_flash_tar.extract())
+			return fail("firmware package " + update_filename + " could not be extracted");
+		done++;
+	}
+
+	Emu.Init();
+	g_firmware = utils::get_firmware_version();
+	sys_log.success("Installed PS3 firmware %s", version_string);
+	host_progress("PS3 system software " + version_string + " installed");
+	return 0;
+}
+
+extern "C" int rpcs3ps5_install_package(const char* /*pkg_path*/)
+{
+	return fail("package install is not ported yet");
+}
+
+extern "C" int rpcs3ps5_run(const char* path)
+{
+	g_error.clear();
+	host_progress(fmt::format("Booting %s", path));
+	sys_log.always()("PS5: booting %s", path);
+
+	const game_boot_result result = Emu.BootGame(path, "", false, cfg_mode::custom);
+	if (result != game_boot_result::no_errors)
+		return fail(fmt::format("boot failed: %s", result));
+
+	// Stand in for Qt's event loop until the game ends
+	u64 touch_held_ms = 0;
+	while (!Emu.IsStopped(true))
+	{
+		pump_main_thread();
+
+		rpcs3ps5_pad pad{};
+		if (g_host.read_pad)
+			g_host.read_pad(&pad);
+		touch_held_ms = (pad.buttons & RPCS3PS5_BTN_TOUCH) ? touch_held_ms + 5 : 0;
+		if (touch_held_ms >= 2000)
+		{
+			sys_log.always()("PS5: touch pad held, stopping");
+			host_progress("Stopping the game...");
+			Emu.GracefulShutdown(false, true);
+			touch_held_ms = 0;
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(5));
+	}
+	pump_main_thread();
+	host_progress("");
+	return 0;
+}
