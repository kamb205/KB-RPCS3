@@ -0,0 +1,41 @@
+// RPCS3 PS5 - the console's own DualSense as player 1's PS3 pad, read through the title
+// (rpcs3ps5_host::read_pad). It takes the dualsense handler's place on the console.
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "Emu/Io/PadHandler.h"
+
+class ps5_pad_handler final : public PadHandlerBase
+{
+public:
+	enum key : u32
+	{
+		None = 0,
+		Cross, Circle, Square, Triangle,
+		L1, R1, L2, R2, L3, R3,
+		Up, Down, Left, Right,
+		Options, Create, Touch,
+		LSXNeg, LSXPos, LSYNeg, LSYPos,
+		RSXNeg, RSXPos, RSYNeg, RSYPos,
+	};
+
+	static constexpr const char* device_name = "PS5 Pad #1";
+
+	ps5_pad_handler();
+
+	bool Init() override { m_is_init = true; return true; }
+	std::vector<pad_list_entry> list_devices() override;
+	void init_config(cfg_pad* cfg) override;
+
+private:
+	std::shared_ptr<PadDevice> m_device;
+
+	std::shared_ptr<PadDevice> get_device(const std::string& device) override;
+	bool get_is_left_trigger(const std::shared_ptr<PadDevice>&, u32 keyCode) override { return keyCode == L2; }
+	bool get_is_right_trigger(const std::shared_ptr<PadDevice>&, u32 keyCode) override { return keyCode == R2; }
+	bool get_is_left_stick(const std::shared_ptr<PadDevice>&, u32 keyCode) override { return keyCode >= LSXNeg && keyCode <= LSYPos; }
+	bool get_is_right_stick(const std::shared_ptr<PadDevice>&, u32 keyCode) override { return keyCode >= RSXNeg && keyCode <= RSYPos; }
+	PadHandlerBase::connection update_connection(const std::shared_ptr<PadDevice>& device) override;
+	std::unordered_map<u32, u16> get_button_values(const std::shared_ptr<PadDevice>& device) override;
+	pad_preview_values get_preview_values(const std::unordered_map<u32, u16>& data, const std::vector<std::string>& buttons) override;
+};
