+// RPCS3 PS5 - the emulator's frontend on the console (ps5_frontend.h): RPCS3's callbacks
+// without Qt (after rpcs3/headless_application.cpp and main_application.cpp), the
+// firmware installer (after rpcs3qt/main_window.cpp's HandlePupInstallation), and the run
+// loop that stands in for Qt's main thread while a game runs.
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include "stdafx.h"
+#include "ps5_frontend.h"
+#include "ps5_gs_frame.h"
+
+#include "Emu/System.h"
+#include "Emu/system_config.h"
+#include "Emu/system_utils.hpp"
+#include "Emu/emu_callbacks.h"
+#include "Emu/vfs_config.h"
+#include "Emu/VFS.h"
+#include "Emu/IdManager.h"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/RSX/Null/NullGSRender.h"
+#include "Emu/RSX/VK/VKGSRender.h"
+#include "Emu/Audio/Null/NullAudioBackend.h"
+#include "Emu/Audio/Null/null_enumerator.h"
+#include "Emu/Io/Null/NullKeyboardHandler.h"
+#include "Emu/Io/Null/NullMouseHandler.h"
+#include "Emu/Io/Null/null_camera_handler.h"
+#include "Emu/Io/Null/null_music_handler.h"
+#include "Emu/Io/KeyboardHandler.h"
+#include "Emu/Io/MouseHandler.h"
+#include "Input/pad_thread.h"
+#include "Loader/PUP.h"
+#include "Loader/TAR.h"
+#include "Crypto/unself.h"
