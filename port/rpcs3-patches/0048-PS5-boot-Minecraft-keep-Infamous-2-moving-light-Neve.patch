+	if (const auto _this = g_tls_this_thread)
+	{
+		// Default-construct the thread result, then publish errored before any lock.
+		// finalize() takes the PS5 thread-list mutex, which a longjmp out of LLVM can
+		// still hold, and the cache build joins on this state.
+		if (g_tls_error_callback)
+		{
+			g_tls_error_callback();
+		}
+
+		_this->m_sync.fetch_op([](u32& v)
+		{
+			v &= -4;
+			v |= static_cast<u32>(thread_state::errored);
+		});
+		_this->m_sync.notify_all();
+
+#ifdef __PROSPERO__
+		if (g_ps5_threads_mutex.try_lock())
+		{
+			std::erase_if(g_ps5_threads, [_this](const ps5_thread_entry& e) { return e.base == _this; });
+			t_ps5_cpu_slot = nullptr;
+			g_ps5_threads_mutex.unlock();
+		}
+#endif
+
+		thread_base::finalize(umax);
+		pthread_exit(nullptr);
+	}
 
 	if (IsDebuggerPresent())
 	{
