+bool spu_recompiler::ps5_inherit_label(u32 pos) const
+{
+	if (!m_ps5_fallthrough || m_entry_info[pos / 4])
+	{
+		return false;
+	}
+
+	const auto preds = m_preds.find(pos);
+
+	if (preds == m_preds.end())
+	{
+		return false;
+	}
+
+	bool any = false;
+
+	for (u32 slot = 0; slot < 16; slot++)
+	{
+		if (m_xmm_owner[slot] >= 0)
+		{
+			any = true;
+			break;
+		}
+	}
+
+	if (!any)
+	{
+		return false;
+	}
+
+	bool saw_fall = false;
+
+	for (u32 pred : preds->second)
+	{
+		if (pred + 4 == pos)
+		{
+			saw_fall = true;
+		}
+		else if (pred < pos)
+		{
+			// Already emitted. That edge cannot be taught this xmm map.
+			return false;
+		}
+	}
+
+	return saw_fall;
+}
+
+void spu_recompiler::ps5_flush_dirty()
+{
+	if (!c)
+	{
+		return;
+	}
+
+	for (u32 i = 0; i < 16; i++)
+	{
+		if (!m_xmm_dirty[i] || m_xmm_owner[i] < 0 || !m_xmm_reg[i])
+		{
+			continue;
+		}
+
+		c->movdqa(SPU_OFF_128(gpr, m_xmm_owner[i]), *m_xmm_reg[i]);
+		m_xmm_dirty[i] = 0;
+	}
+}
+
+void spu_recompiler::ps5_drop_gpr_cache()
+{
+	ps5_flush_dirty();
+
+	for (u32 i = 0; i < 16; i++)
+	{
+		m_xmm_owner[i] = -1;
+		m_xmm_dirty[i] = 0;
+		m_xmm_taken[i] = 0;
+
+		if (m_xmm_reg[i])
+		{
+			vec[i] = m_xmm_reg[i];
+		}
+	}
+}
+
+bool spu_recompiler::ps5_note_store(s8 rt, const XmmLink& v)
+{
+	const auto* stored = &static_cast<const asmjit::x86::Xmm&>(v);
+
+	for (u32 i = 0; i < 16; i++)
+	{
+		if (m_xmm_reg[i] != stored)
+		{
+			continue;
+		}
+
+		for (u32 j = 0; j < 16; j++)
+		{
+			if (j != i && m_xmm_owner[j] == rt)
+			{
+				// This instruction overwrites that copy. Do not flush it back.
+				m_xmm_owner[j] = -1;
+				m_xmm_dirty[j] = 0;
+			}
+		}
+
+		m_xmm_owner[i] = rt;
+		m_xmm_taken[i] = 0;
+		m_xmm_dirty[i] = 0;
+		return true;
+	}
+
+	return false;
+}
+
+void spu_recompiler::gpr_store(s8 rt, const XmmLink& v)
+{
+	c->movdqa(SPU_OFF_128(gpr, rt), v);
+	ps5_note_store(rt, v);
+}
+
+void spu_recompiler::gpr_store_ps(s8 rt, const XmmLink& v)
+{
+	c->movaps(SPU_OFF_128(gpr, rt), v);
+	ps5_note_store(rt, v);
+}
+
+void spu_recompiler::gpr_store_pd(s8 rt, const XmmLink& v)
+{
+	c->movapd(SPU_OFF_128(gpr, rt), v);
+	ps5_note_store(rt, v);
