+bool spu_recompiler::ps5_defer_store(u32 opcode) const
+{
+	const auto type = g_spu_itype.decode(opcode);
+
+	if (!(type & spu_itype::integer) && !(type & spu_itype::floating) && !(type & spu_itype::shiftrot) && !(type & spu_itype::compare) && !(type & spu_itype::constant))
+	{
+		return false;
+	}
+
+	// These read a GPR scalar from memory, or write the result past the cache.
+	if (type == spu_itype::ROT || type == spu_itype::ROTM || type == spu_itype::ROTMA || type == spu_itype::SHL ||
+		type == spu_itype::ROTQBY || type == spu_itype::ROTQMBY || type == spu_itype::SHLQBY ||
+		type == spu_itype::ROTQBYBI || type == spu_itype::ROTQMBYBI || type == spu_itype::SHLQBYBI ||
+		type == spu_itype::CBX || type == spu_itype::CHX || type == spu_itype::CWX || type == spu_itype::CDX ||
+		type == spu_itype::CBD || type == spu_itype::CHD || type == spu_itype::CWD || type == spu_itype::CDD ||
+		type == spu_itype::XSWD)
+	{
+		return false;
+	}
+
+	return true;
+}
