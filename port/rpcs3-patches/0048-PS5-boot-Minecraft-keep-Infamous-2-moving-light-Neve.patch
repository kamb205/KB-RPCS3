+u32 spu_recompiler::ps5_src_count(s8 reg) const
+{
+	if (!m_ps5_words || reg < 0)
+	{
+		return 2;
+	}
+
+	const u32 i = (m_pos - m_ps5_start) / 4;
+
+	if (i >= m_ps5_count)
+	{
+		return 2;
+	}
+
+	const u32 opcode = std::bit_cast<be_t<u32>>(m_ps5_words[i]);
+	const auto [rt, srcs, masked] = op_register_targets(m_pos, spu_opcode_t{opcode});
+	(void)rt;
+	(void)masked;
+	u32 n = 0;
+
+	for (u32 s : srcs)
+	{
+		if (s == static_cast<u32>(reg))
+		{
+			n++;
+		}
+	}
+
+	return n;
+}
+
+bool spu_recompiler::ps5_src_dead(s8 reg) const
+{
+	if (!m_ps5_words || reg < 0)
+	{
+		return false;
+	}
+
+	for (u32 pos = m_pos + 4; ; pos += 4)
+	{
+		if (pos / 4 >= (SPU_LS_SIZE / 4) || m_block_info[pos / 4])
+		{
+			return false;
+		}
+
+		const u32 i = (pos - m_ps5_start) / 4;
+
+		if (i >= m_ps5_count)
+		{
+			return false;
+		}
+
+		const u32 opcode = std::bit_cast<be_t<u32>>(m_ps5_words[i]);
+
+		if (!opcode)
+		{
+			return false;
+		}
+
+		const auto type = g_spu_itype.decode(opcode);
+		const auto [rt, srcs, masked] = op_register_targets(pos, spu_opcode_t{opcode});
+		(void)masked;
+
+		for (u32 s : srcs)
+		{
+			if (s == static_cast<u32>(reg))
+			{
+				return false;
+			}
+		}
+
+		if (rt != u32{umax} && rt == static_cast<u32>(reg))
+		{
+			return true;
+		}
+
+		if ((type & spu_itype::branch) || type == spu_itype::STOP || type == spu_itype::STOPD || !g_spu_iflag.decode(opcode))
+		{
+			return false;
+		}
+	}
+}
