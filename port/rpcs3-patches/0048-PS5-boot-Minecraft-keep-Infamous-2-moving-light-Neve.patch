+// Guest location of a hot SPU and of the PPU main thread. Call after ps5_thread_cpu_report(),
+// which has already signalled each thread to snapshot its own PC.
+std::string ps5_busy_guest_pcs()
+{
+	std::lock_guard lock(g_ps5_threads_mutex);
+	std::string out;
+	for (const auto& e : g_ps5_threads)
+	{
+		if (!e.guest)
+			continue;
+		const std::string& name = *e.name->load();
+		const u32 flags = e.guest->flags.load(std::memory_order_relaxed);
+		const bool hot_spu = (flags == 1 || flags == 2) && e.last_pct >= 40;
+		const bool any_ppu = flags == 4;
+		if (hot_spu)
+			fmt::append(out, "%s %u%% pc=0x%05x op=0x%08x %s raddr=0x%x mask=0x%x | ", name, e.last_pct,
+				e.guest->pc.load(std::memory_order_relaxed), e.guest->op.load(std::memory_order_relaxed),
+				flags == 2 ? "wait" : "run", e.guest->aux.load(std::memory_order_relaxed), e.guest->aux2.load(std::memory_order_relaxed));
+		else if (any_ppu)
+		{
+			const char* fn = e.guest->fn.load(std::memory_order_relaxed);
+			fmt::append(out, "%s %u%% cia=0x%08x %s state=0x%x | ", name, e.last_pct,
+				e.guest->pc.load(std::memory_order_relaxed), fn ? fn : "-", e.guest->aux.load(std::memory_order_relaxed));
+		}
+	}
+	if (out.empty())
+		out = "(none)";
+	return out;
+}
