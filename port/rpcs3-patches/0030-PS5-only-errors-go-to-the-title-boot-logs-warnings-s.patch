From e1affc11ce19160502a6de3ef9004460f616e038 Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Tue, 6 Oct 2026 21:36:09 +0100
Subject: [PATCH 30/47] PS5: only errors go to the title/boot logs (warnings
 slowed file-heavy games)

---
 rpcs3/ps5/ps5_frontend.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
index 3f83eb5e8..65d36e7ee 100644
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -106,12 +106,14 @@ void pump_main_thread()
 	}
 }
 
-// Warnings and worse reach the title's log as they happen; everything goes to RPCS3.log
+// Errors and worse reach the title's log as they happen; everything goes to RPCS3.log. Warnings stay
+// out: host_log() writes klog and an fsync'd ps5-boot.log on the logging thread, and games log a
+// warning per file operation (WWE 12's game data install crawled at ~20 MB/s because of it).
 struct host_listener final : logs::listener
 {
 	void log(u64 /*stamp*/, const logs::message& msg, std::string_view prefix, std::string_view text) override
 	{
-		if (msg <= logs::level::warning)
+		if (msg <= logs::level::error)
 		{
 			std::string line = "rpcs3: ";
 			line += prefix;
-- 
