diff --git a/rpcs3/Emu/RSX/VK/vkutils/swapchain_ps5.hpp b/rpcs3/Emu/RSX/VK/vkutils/swapchain_ps5.hpp
new file mode 100644
index 000000000..be13e1310
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/swapchain_ps5.hpp
@@ -0,0 +1,121 @@
+#pragma once
+
+#include "swapchain_core.h"
+#include "util/logs.hpp"
+
+#include <vector>
+
+namespace vk
+{
+#if defined(__PROSPERO__)
+	// PS5: RADV's VK_KHR_display presents straight to the console's VideoOut.
+	// The window handle carries nothing; the surface is the display's own mode.
+	using swapchain_PS5 = native_swapchain_base;
+	using swapchain_NATIVE = swapchain_PS5;
+
+	[[maybe_unused]] static
+	VkSurfaceKHR make_WSI_surface(VkInstance vk_instance, display_handle_t /*window_handle*/, WSI_config* /*config*/)
+	{
+		u32 gpu_count = 0;
+		vkEnumeratePhysicalDevices(vk_instance, &gpu_count, nullptr);
+		if (!gpu_count)
+		{
+			rsx_log.error("PS5: no physical device for the display surface");
+			return VK_NULL_HANDLE;
+		}
+		std::vector<VkPhysicalDevice> gpus(gpu_count);
+		vkEnumeratePhysicalDevices(vk_instance, &gpu_count, gpus.data());
+		const VkPhysicalDevice gpu = gpus[0];
+
+		u32 display_count = 0;
+		vkGetPhysicalDeviceDisplayPropertiesKHR(gpu, &display_count, nullptr);
+		std::vector<VkDisplayPropertiesKHR> displays(display_count);
+		vkGetPhysicalDeviceDisplayPropertiesKHR(gpu, &display_count, displays.data());
+
+		u32 plane_count = 0;
+		vkGetPhysicalDeviceDisplayPlanePropertiesKHR(gpu, &plane_count, nullptr);
+		std::vector<VkDisplayPlanePropertiesKHR> planes(plane_count);
+		vkGetPhysicalDeviceDisplayPlanePropertiesKHR(gpu, &plane_count, planes.data());
+
+		// The console has one display and one mode (3840x2160); take the largest mode offered
+		VkDisplayKHR display = VK_NULL_HANDLE;
+		VkDisplayModePropertiesKHR best{};
+		for (const auto& properties : displays)
+		{
+			u32 mode_count = 0;
+			vkGetDisplayModePropertiesKHR(gpu, properties.display, &mode_count, nullptr);
+			std::vector<VkDisplayModePropertiesKHR> modes(mode_count);
+			vkGetDisplayModePropertiesKHR(gpu, properties.display, &mode_count, modes.data());
+			for (const auto& mode : modes)
+			{
+				const u64 area = u64{mode.parameters.visibleRegion.width} * mode.parameters.visibleRegion.height;
+				if (area > u64{best.parameters.visibleRegion.width} * best.parameters.visibleRegion.height)
+				{
+					best = mode;
+					display = properties.display;
+				}
+			}
+		}
+
+		if (display == VK_NULL_HANDLE)
+		{
+			rsx_log.error("PS5: no display mode");
+			return VK_NULL_HANDLE;
+		}
+
+		u32 plane_index = umax;
+		for (u32 i = 0; i < plane_count && plane_index == umax; i++)
+		{
+			u32 count = 0;
+			vkGetDisplayPlaneSupportedDisplaysKHR(gpu, i, &count, nullptr);
+			std::vector<VkDisplayKHR> supported(count);
+			vkGetDisplayPlaneSupportedDisplaysKHR(gpu, i, &count, supported.data());
+			for (VkDisplayKHR candidate : supported)
+			{
+				if (candidate == display)
+				{
+					plane_index = i;
+					break;
+				}
+			}
+		}
+
+		if (plane_index == umax)
+		{
+			rsx_log.error("PS5: no display plane");
+			return VK_NULL_HANDLE;
+		}
+
+		VkDisplayPlaneCapabilitiesKHR caps{};
+		vkGetDisplayPlaneCapabilitiesKHR(gpu, best.displayMode, plane_index, &caps);
+		VkDisplayPlaneAlphaFlagBitsKHR alpha = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+		if (!(caps.supportedAlpha & VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR))
+		{
+			for (auto bit : { VK_DISPLAY_PLANE_ALPHA_GLOBAL_BIT_KHR, VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_BIT_KHR, VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_PREMULTIPLIED_BIT_KHR })
+			{
+				if (caps.supportedAlpha & bit)
+				{
+					alpha = bit;
+					break;
+				}
+			}
+		}
+
+		VkDisplaySurfaceCreateInfoKHR info{};
+		info.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+		info.displayMode = best.displayMode;
+		info.planeIndex = plane_index;
+		info.planeStackIndex = planes[plane_index].currentStackIndex;
+		info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+		info.globalAlpha = 1.0f;
+		info.alphaMode = alpha;
+		info.imageExtent = best.parameters.visibleRegion;
+
+		VkSurfaceKHR result = VK_NULL_HANDLE;
+		CHECK_RESULT(vkCreateDisplayPlaneSurfaceKHR(vk_instance, &info, nullptr, &result));
+		rsx_log.notice("PS5: display surface %ux%u @ %u mHz, plane %u", info.imageExtent.width, info.imageExtent.height,
+			best.parameters.refreshRate, plane_index);
+		return result;
+	}
+#endif
+}
