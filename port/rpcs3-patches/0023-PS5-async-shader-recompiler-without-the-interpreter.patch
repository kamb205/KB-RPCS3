From ebef2a20f27022ffe3e3b6db7e5cc98447a6cb3d Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Tue, 6 Oct 2026 10:52:15 +0100
Subject: [PATCH 23/47] PS5: async shader recompiler without the interpreter

---
 rpcs3/ps5/ps5_frontend.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
index 7084675df..6db138d30 100644
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -208,6 +208,9 @@ void create_callbacks()
 void apply_defaults()
 {
 	g_cfg.video.renderer.set(video_renderer::vulkan);
+	// No shader interpreter: its ubershader took minutes to build on the console with the boot waiting on it
+	// (console run 15); shaders are recompiled in the background instead
+	g_cfg.video.shadermode.set(shader_mode::async_recompiler);
 	// Any renderer but null is the PS5 backend (get_audio); cubeb is the default's name
 	g_cfg.audio.renderer.set(audio_renderer::cubeb);
 	g_cfg.audio.format.set(audio_format::stereo);
-- 
