diff --git a/rpcs3/ps5/ps5_text_mirror.cpp b/rpcs3/ps5/ps5_text_mirror.cpp
new file mode 100644
index 000000000..c4213bc4d
--- /dev/null
+++ b/rpcs3/ps5/ps5_text_mirror.cpp
@@ -0,0 +1,68 @@
+// RPCS3 PS5 - a readable copy of the title's own code.
+//
+// The console maps a title's code execute-only (SYSTEM_XO_VIOLATION on a read). RPCS3's access
+// violation handler reads the faulting x86 instruction to emulate it (Utilities/Thread.cpp:
+// decode_x64_reg_op and the immediates after it), and RPCS3 is linked into the title, so that read
+// faulted the moment an SPU transfer took the emulated path (WWE 12, console run 2). The build stages
+// the executable segment's bytes as /app0/rpcs3ps5-text.bin (tools/link-title.sh), loaded here once;
+// rpcs3ps5_readable_code() maps an address inside the code to the same byte in the copy.
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include "stdafx.h"
+#include "util/types.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+
+LOG_CHANNEL(sys_log, "SYS");
+
+extern "C" char __ehdr_start[] __attribute__((weak)); // the title's load address (lld)
+
+namespace
+{
+const u8* g_mirror = nullptr;
+uptr g_begin = 0;
+uptr g_end = 0;
+}
+
+extern "C" const u8* rpcs3ps5_readable_code(const u8* code)
+{
+	const uptr at = reinterpret_cast<uptr>(code);
+	if (g_mirror && at >= g_begin && at < g_end)
+		return g_mirror + (at - g_begin);
+	return code;
+}
+
+// "RPCS3PS5TEXT" header: the segment's link address and size, then its bytes
+void rpcs3ps5_load_text_mirror(const char* path)
+{
+	std::FILE* file = std::fopen(path, "rb");
+	if (!file)
+	{
+		sys_log.error("PS5: no readable code copy at %s: an emulated access in the title's code will fault", path);
+		return;
+	}
+	char magic[12]{};
+	u64 vaddr = 0, size = 0;
+	if (std::fread(magic, 1, 12, file) != 12 || std::memcmp(magic, "RPCS3PS5TEXT", 12) != 0 ||
+		std::fread(&vaddr, 8, 1, file) != 1 || std::fread(&size, 8, 1, file) != 1 || size == 0 || size > (1ull << 30))
+	{
+		sys_log.error("PS5: %s is not a code copy", path);
+		std::fclose(file);
+		return;
+	}
+	u8* copy = static_cast<u8*>(std::malloc(size));
+	if (!copy || std::fread(copy, 1, size, file) != size)
+	{
+		sys_log.error("PS5: could not read the code copy (%llu bytes)", size);
+		std::free(copy);
+		std::fclose(file);
+		return;
+	}
+	std::fclose(file);
+	const uptr base = __ehdr_start ? reinterpret_cast<uptr>(__ehdr_start) : 0x400000;
+	g_begin = base + vaddr;
+	g_end = g_begin + size;
+	g_mirror = copy;
+	sys_log.notice("PS5: readable code copy loaded: %p..%p (%llu MiB)", reinterpret_cast<void*>(g_begin), reinterpret_cast<void*>(g_end), size >> 20);
+}
