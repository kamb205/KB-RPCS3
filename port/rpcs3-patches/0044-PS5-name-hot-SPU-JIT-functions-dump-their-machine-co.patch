+
+// The clock this thread's core runs at: a chain of dependent adds (one cycle each on Zen 2) timed with the TSC,
+// best of 3 runs of 1.6 M cycles (~0.5 ms each). Tells whether the console gives the title its full CPU clock.
+static u32 ps5_core_mhz()
+{
+	constexpr u64 rounds = 200'000; // 8 adds per round
+	u64 best = umax;
+	for (int run = 0; run < 3; run++)
+	{
+		u64 x = 0, i = rounds;
+		const u64 t0 = utils::get_tsc();
+		__asm__ volatile(
+			"1:\n\t"
+			"addq $1, %0\n\taddq $1, %0\n\taddq $1, %0\n\taddq $1, %0\n\t"
+			"addq $1, %0\n\taddq $1, %0\n\taddq $1, %0\n\taddq $1, %0\n\t"
+			"decq %1\n\t"
+			"jnz 1b"
+			: "+r"(x), "+r"(i));
+		best = std::min(best, utils::get_tsc() - t0);
+	}
+	return static_cast<u32>(rounds * 8 * (utils::get_tsc_freq() / 1000) / std::max<u64>(best, 1) / 1000);
+}
+
 LOG_CHANNEL(sys_log, "SYS");
 
