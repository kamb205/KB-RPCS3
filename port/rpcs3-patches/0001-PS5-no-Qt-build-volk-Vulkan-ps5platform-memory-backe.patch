diff --git a/rpcs3/util/vm_native_ps5.cpp b/rpcs3/util/vm_native_ps5.cpp
new file mode 100644
index 000000000..7e48f8fc8
--- /dev/null
+++ b/rpcs3/util/vm_native_ps5.cpp
@@ -0,0 +1,306 @@
+// PS5 (Prospero) backend of utils' virtual memory API (util/vm.hpp).
+//
+// A title's anonymous mmap draws on its small flexible budget (~400 MiB), so every
+// reservation, commit and shared-memory object here lives in direct memory through
+// the PS5 platform layer (PS5_PayloadSDK fork, ps5platform/shm.h):
+//   memory_reserve  -> ps5_vrange_reserve(_at): address space outside the GPU window
+//   memory_commit   -> ps5_vrange_commit: 64 KiB direct units, mapped at first commit
+//   memory_decommit -> ps5_vrange_decommit (zero at the next commit)
+//   shm             -> ps5_shm_create/map: one direct allocation, any number of views
+// Execute is never granted at map time on the console; it is added by mprotect after.
+#include "stdafx.h"
+
+#ifdef __PROSPERO__
+
+#include "util/vm.hpp"
+#include "util/asm.hpp"
+
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <ps5platform/shm.h>
+
+namespace utils
+{
+	long get_page_size()
+	{
+		static const long r = []() -> long
+		{
+			const long size = ::sysconf(_SC_PAGESIZE);
+			return size > 0 ? size : 0x4000;
+		}();
+
+		return r;
+	}
+
+	static int to_posix(protection prot)
+	{
+		switch (prot)
+		{
+		case protection::rw: return PROT_READ | PROT_WRITE;
+		case protection::ro: return PROT_READ;
+		case protection::no: return PROT_NONE;
+		case protection::wx: return PROT_READ | PROT_WRITE | PROT_EXEC;
+		case protection::rx: return PROT_READ | PROT_EXEC;
+		}
+
+		return PROT_NONE;
+	}
+
+	static int to_ps5(protection prot)
+	{
+		switch (prot)
+		{
+		case protection::rw: return PS5_SHM_READ | PS5_SHM_WRITE;
+		case protection::ro: return PS5_SHM_READ;
+		case protection::no: return 0;
+		case protection::wx: return PS5_SHM_READ | PS5_SHM_WRITE | PS5_SHM_EXEC;
+		case protection::rx: return PS5_SHM_READ | PS5_SHM_EXEC;
+		}
+
+		return 0;
+	}
+
+	static void* page_floor(void* pointer, usz& size)
+	{
+		const u64 ptr64 = reinterpret_cast<u64>(pointer);
+		const u64 mask = get_page_size() - 1;
+		size += ptr64 & mask;
+		return reinterpret_cast<void*>(ptr64 & ~mask);
+	}
+
+	void* memory_reserve(usz size, void* use_addr, [[maybe_unused]] bool is_memory_mapping, [[maybe_unused]] bool can_be_jit)
+	{
+		size = utils::align(size, 0x10000);
+
+		if (use_addr)
+		{
+			if (reinterpret_cast<uptr>(use_addr) % 0x10000)
+			{
+				return nullptr;
+			}
+
+			return ps5_vrange_reserve_at(use_addr, size) == 0 ? use_addr : nullptr;
+		}
+
+		void* base = nullptr;
+		return ps5_vrange_reserve(size, nullptr, 0x10000, &base) == 0 ? base : nullptr;
+	}
+
+	void memory_commit(void* pointer, usz size, protection prot)
+	{
+		if (!size)
+		{
+			return;
+		}
+
+		ensure(ps5_vrange_commit(pointer, size, to_ps5(prot)) == 0);
+	}
+
+	void memory_decommit(void* pointer, usz size, [[maybe_unused]] bool can_be_jit)
+	{
+		if (!size)
+		{
+			return;
+		}
+
+		ensure(ps5_vrange_decommit(pointer, size) == 0);
+	}
+
+	void memory_reset(void* pointer, usz size, protection prot, [[maybe_unused]] bool can_be_jit)
+	{
+		if (!size)
+		{
+			return;
+		}
+
+		memory_decommit(pointer, size);
+		memory_commit(pointer, size, prot);
+	}
+
+	void memory_release(void* pointer, usz size)
+	{
+		if (!size)
+		{
+			return;
+		}
+
+		ensure(ps5_vrange_release(pointer, utils::align(size, 0x10000)) == 0);
+	}
+
+	void memory_protect(void* pointer, usz size, protection prot)
+	{
+		if (!size)
+		{
+			return;
+		}
+
+		void* const base = page_floor(pointer, size);
+		ensure(::mprotect(base, size, to_posix(prot)) != -1);
+	}
+
+	bool memory_lock(void*, usz)
+	{
+		// Direct memory is never paged out
+		return true;
+	}
+
+	void* memory_map_fd(native_handle, usz, protection)
+	{
+		return nullptr;
+	}
+
+	static ps5_shm as_ps5(s64 start, u64 bytes)
+	{
+		ps5_shm shm{};
+		shm.direct_start = start;
+		shm.bytes = bytes;
+		return shm;
+	}
+
+	shm::shm(u64 size, u32 flags)
+		: m_flags(flags)
+		, m_size(utils::align(size, 0x10000))
+	{
+		ps5_shm shm{};
+		const int error = ps5_shm_create(m_size, &shm);
+
+		if (error)
+		{
+			fmt::throw_exception("ps5_shm_create(0x%x) failed: 0x%x", m_size, error);
+		}
+
+		m_direct = shm.direct_start;
+		m_direct_bytes = shm.bytes;
+	}
+
+	shm::shm(u64 size, const std::string& storage)
+		: shm(size, 0u)
+	{
+		// No sparse file storage on the console: the object is direct memory
+		static_cast<void>(storage);
+	}
+
+	shm::~shm()
+	{
+		this->unmap_self();
+
+		ps5_shm shm = as_ps5(m_direct, m_direct_bytes);
+		ps5_shm_destroy(&shm);
+	}
+
+	static u8* ps5_map(s64 start, u64 bytes, u64 size, void* address, protection prot, unsigned flags)
+	{
+		const ps5_shm shm = as_ps5(start, bytes);
+
+		// Execute is refused at map time: map read-write (or no access), add it after
+		const bool exec = prot == protection::wx || prot == protection::rx;
+		const int map_prot = exec ? (PS5_SHM_READ | PS5_SHM_WRITE) : to_ps5(prot);
+
+		void* view = nullptr;
+
+		if (ps5_shm_map(&shm, 0, size, address, map_prot, flags, &view) != 0 || !view)
+		{
+			return nullptr;
+		}
+
+		if (exec && ::mprotect(view, size, to_posix(prot)) == -1)
+		{
+			ps5_shm_unmap(view, size, (flags & PS5_SHM_FIXED) ? PS5_SHM_KEEP_RESERVED : 0);
+			return nullptr;
+		}
+
+		return static_cast<u8*>(view);
+	}
+
+	u8* shm::map(void* ptr, protection prot, [[maybe_unused]] bool cow) const
+	{
+		const u64 ptr64 = reinterpret_cast<u64>(ptr) & -0x10000;
+		return ps5_map(m_direct, m_direct_bytes, m_size, reinterpret_cast<void*>(ptr64), prot, ptr64 ? PS5_SHM_FIXED : 0);
+	}
+
+	u8* shm::try_map(void* ptr, protection prot, [[maybe_unused]] bool cow) const
+	{
+		const auto target = ensure(reinterpret_cast<u8*>(reinterpret_cast<u64>(ptr) & -0x10000));
+		u8* const result = ps5_map(m_direct, m_direct_bytes, m_size, target, prot, 0);
+
+		if (result && result != target)
+		{
+			ps5_shm_unmap(result, m_size, 0);
+			return nullptr;
+		}
+
+		return result;
+	}
+
+	std::pair<u8*, std::string> shm::map_critical(void* ptr, protection prot, bool cow)
+	{
+		const auto target = reinterpret_cast<u8*>(reinterpret_cast<u64>(ptr) & -0x10000);
+		const auto mapped_addr = this->map(target, prot, cow);
+
+		if (!mapped_addr)
+		{
+			return {nullptr, "ps5_shm_map failed"};
+		}
+
+		return {mapped_addr, {}};
+	}
+
+	u8* shm::map_self(protection prot)
+	{
+		void* ptr = m_ptr;
+
+		for (void* mapped = nullptr; !ptr;)
+		{
+			if (!mapped)
+			{
+				mapped = this->map(nullptr, prot);
+
+				if (!mapped)
+				{
+					if ((ptr = m_ptr))
+					{
+						break;
+					}
+
+					return nullptr;
+				}
+			}
+
+			if (m_ptr.compare_exchange(ptr, mapped))
+			{
+				ptr = mapped;
+			}
+			else if (ptr)
+			{
+				ensure(ptr != mapped);
+				ps5_shm_unmap(mapped, m_size, 0);
+			}
+		}
+
+		return static_cast<u8*>(ptr);
+	}
+
+	void shm::unmap(void* ptr) const
+	{
+		// Views are mostly mapped inside reservations (vm, SPU LS mirrors): keep the range
+		ps5_shm_unmap(ptr, m_size, PS5_SHM_KEEP_RESERVED);
+	}
+
+	void shm::unmap_critical(void* ptr)
+	{
+		// The view goes, the range it sat in stays reserved (Linux leaves it PROT_NONE)
+		const auto target = reinterpret_cast<u8*>(reinterpret_cast<u64>(ptr) & -0x10000);
+		ensure(ps5_shm_unmap(target, m_size, PS5_SHM_KEEP_RESERVED) == 0);
+	}
+
+	void shm::unmap_self()
+	{
+		if (auto ptr = m_ptr.exchange(nullptr))
+		{
+			ps5_shm_unmap(ptr, m_size, 0);
+		}
+	}
+} // namespace utils
+
+#endif // __PROSPERO__
-- 
