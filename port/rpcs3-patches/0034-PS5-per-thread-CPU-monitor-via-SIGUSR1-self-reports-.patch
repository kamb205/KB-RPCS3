--- a/Utilities/Thread.cpp
+++ b/Utilities/Thread.cpp
@@ -47,6 +47,7 @@ DYNAMIC_IMPORT_RENAME("Kernel32.dll", SetThreadDescriptionImport, "SetThreadDesc
 #endif
 #include <errno.h>
 #include <signal.h>
+#include <unordered_map>
 #ifndef __OpenBSD__
 #include <ucontext.h>
