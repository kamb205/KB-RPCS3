@@ -2831,37 +2832,85 @@ void thread_base::start()
 }
 
 #ifdef __PROSPERO__
-// PS5 CPU monitor: every RPCS3 thread with its CPU-time clock, for ps5_thread_cpu_report()
-// (rpcs3/ps5/ps5_frontend.cpp logs it every few seconds while a game runs)
+// PS5 CPU monitor: every RPCS3 thread's CPU time, for ps5_thread_cpu_report() (rpcs3/ps5/ps5_frontend.cpp
+// logs it every few seconds while a game runs). On the console pthread_getcpuclockid() hands back the
+// *calling* thread's clock (14), so another thread's time can't be read directly: the monitor sends each
+// thread SIGUSR1 and the thread stores its own CLOCK_THREAD_CPUTIME_ID in its slot.
 namespace
 {
 	struct ps5_thread_entry
 	{
 		thread_base* base;
 		const atomic_ptr<std::string>* name; // the thread_base's name (m_tname is private)
-		clockid_t clock;
+		pthread_t thread;
+		std::shared_ptr<std::atomic<u64>> cpu_ns; // written by the thread's signal handler
 		u64 last_ns;
 	};
 	std::mutex g_ps5_threads_mutex;
 	std::vector<ps5_thread_entry> g_ps5_threads;
+	thread_local std::atomic<u64>* t_ps5_cpu_slot = nullptr;
 
-	u64 ps5_clock_ns(clockid_t clock)
+	u64 ps5_own_cpu_ns()
 	{
 		timespec ts{};
-		return ::clock_gettime(clock, &ts) == 0 ? ts.tv_sec * 1'000'000'000ull + ts.tv_nsec : 0;
+		return ::clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0 ? ts.tv_sec * 1'000'000'000ull + ts.tv_nsec : 0;
+	}
+
+	// Sampling profiler: while g_ps5_sample_target is a thread's slot, its SIGUSR1 also records where it was
+	std::atomic<std::atomic<u64>*> g_ps5_sample_target{nullptr};
+	constexpr usz ps5_max_samples = 4096;
+	u64 g_ps5_samples[ps5_max_samples];
+	std::atomic<usz> g_ps5_sample_count{0};
+
+	void ps5_cpu_signal(int, siginfo_t*, void* uct)
+	{
+		auto* slot = t_ps5_cpu_slot;
+		if (!slot)
+			return;
+		slot->store(ps5_own_cpu_ns(), std::memory_order_relaxed);
+		if (slot == g_ps5_sample_target.load(std::memory_order_relaxed) && uct)
+		{
+			const usz i = g_ps5_sample_count.fetch_add(1, std::memory_order_relaxed);
+			if (i < ps5_max_samples)
+				g_ps5_samples[i] = static_cast<ucontext_t*>(uct)->uc_mcontext.mc_rip;
+		}
+	}
+
+	void ps5_cpu_register(thread_base* base, const atomic_ptr<std::string>* name)
+	{
+		static const bool installed = []
+		{
+			struct sigaction action{};
+			action.sa_sigaction = ps5_cpu_signal;
+			action.sa_flags = SA_RESTART | SA_SIGINFO;
+			sigemptyset(&action.sa_mask);
+			return ::sigaction(SIGUSR1, &action, nullptr) == 0;
+		}();
+		if (!installed)
+			return;
+		auto slot = std::make_shared<std::atomic<u64>>(ps5_own_cpu_ns());
+		t_ps5_cpu_slot = slot.get();
+		std::lock_guard lock(g_ps5_threads_mutex);
+		g_ps5_threads.push_back({base, name, ::pthread_self(), slot, slot->load()});
 	}
 }
 
 // "total 612% | PPU[0x1000000] main_thread 98% | SPU[...] 95% | ..." over the time since the last call
 std::string ps5_thread_cpu_report(u64 window_ns, usz top)
 {
+	{
+		std::lock_guard lock(g_ps5_threads_mutex);
+		for (auto& e : g_ps5_threads)
+			::pthread_kill(e.thread, SIGUSR1);
+	}
+	std::this_thread::sleep_for(std::chrono::milliseconds(30));
 	std::vector<std::pair<u64, std::string>> rows;
 	u64 total = 0;
 	{
 		std::lock_guard lock(g_ps5_threads_mutex);
 		for (auto& e : g_ps5_threads)
 		{
-			const u64 now = ps5_clock_ns(e.clock);
+			const u64 now = e.cpu_ns->load(std::memory_order_relaxed);
 			const u64 used = now > e.last_ns ? now - e.last_ns : 0;
 			e.last_ns = now;
 			total += used;
@@ -2875,6 +2924,52 @@ std::string ps5_thread_cpu_report(u64 window_ns, usz top)
 		fmt::append(out, " | %s %u%%", rows[i].second, rows[i].first * 100 / std::max<u64>(window_ns, 1));
 	return out;
 }
+
+// Samples where the thread named `name` executes, `count` times 5 ms apart; "addr:hits ..." (most hit first),
+// addresses as in the title image (symbolise addr-0x400000 against llvm-pie.elf)
+std::string ps5_thread_profile(const std::string& name, usz count)
+{
+	pthread_t thread{};
+	std::shared_ptr<std::atomic<u64>> slot;
+	{
+		std::lock_guard lock(g_ps5_threads_mutex);
+		for (auto& e : g_ps5_threads)
+			if (*e.name->load() == name)
+			{
+				thread = e.thread;
+				slot = e.cpu_ns;
+				break;
+			}
+	}
+	if (!slot)
+		return "no such thread";
+	g_ps5_sample_count = 0;
+	g_ps5_sample_target = slot.get();
+	for (usz i = 0; i < count && i < ps5_max_samples; i++)
+	{
+		{
+			std::lock_guard lock(g_ps5_threads_mutex);
+			if (std::none_of(g_ps5_threads.begin(), g_ps5_threads.end(), [&](const ps5_thread_entry& e) { return e.cpu_ns == slot; }))
+				break;
+			::pthread_kill(thread, SIGUSR1);
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(5));
+	}
+	g_ps5_sample_target = nullptr;
+	std::this_thread::sleep_for(std::chrono::milliseconds(10));
+	const usz n = std::min<usz>(g_ps5_sample_count, ps5_max_samples);
+	std::unordered_map<u64, u32> hits;
+	for (usz i = 0; i < n; i++)
+		hits[g_ps5_samples[i]]++;
+	std::vector<std::pair<u32, u64>> sorted;
+	for (const auto& [addr, h] : hits)
+		sorted.emplace_back(h, addr);
+	std::sort(sorted.begin(), sorted.end(), std::greater<>());
+	std::string out = fmt::format("%u samples:", n);
+	for (usz i = 0; i < sorted.size() && i < 60; i++)
+		fmt::append(out, " %x:%u", sorted[i].second, sorted[i].first);
+	return out;
+}
 #endif
 
 void thread_base::initialize(void (*error_cb)())
@@ -2910,11 +3005,7 @@ void thread_base::initialize(void (*error_cb)())
 	thread_ctrl::g_tls_this_thread = this;
 
 #ifdef __PROSPERO__
-	if (clockid_t clock; ::pthread_getcpuclockid(::pthread_self(), &clock) == 0)
-	{
-		std::lock_guard lock(g_ps5_threads_mutex);
-		g_ps5_threads.push_back({this, &m_tname, clock, ps5_clock_ns(clock)});
-	}
+	ps5_cpu_register(this, &m_tname);
 #endif
 
 	thread_ctrl::g_tls_error_callback = error_cb;
@@ -2997,6 +3088,7 @@ u64 thread_base::finalize(thread_state result_state) noexcept
 	{
 		std::lock_guard lock(g_ps5_threads_mutex);
 		std::erase_if(g_ps5_threads, [this](const ps5_thread_entry& e) { return e.base == this; });
+		t_ps5_cpu_slot = nullptr;
 	}
 #endif
 
