From c516d126becc09de0fc08d03ba585308a9abe6ef Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Thu, 8 Oct 2026 11:45:42 +0100
Subject: [PATCH 41/47] PS5: CPU/FPS report windows measured at the report

---
 rpcs3/ps5/ps5_frontend.cpp | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
index d7340b75c..642cadc84 100644
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -778,20 +778,26 @@ void start_watchdog()
 			// CPU monitor: each RPCS3 thread's share of a core over the last ~4 s (100% = one core)
 			if (now - last_cpu >= 4000)
 			{
+				// The window is measured at the report itself: the profile below takes 2 s of its own, and windows
+				// measured from before it read 1.5x too high (2026-10-08)
+				static u64 last_report = now_ms();
+				const u64 report_time = now_ms();
+				const u64 window_ms = std::max<u64>(report_time - last_report, 1);
+				last_report = report_time;
 				{
 					static u64 last_flips = 0;
 					const u64 flips = g_ps5_flips.load();
-					sys_log.notice("PS5 FPS: %.1f", (flips - last_flips) * 1000.0 / std::max<u64>(now - last_cpu, 1));
+					sys_log.notice("PS5 FPS: %.1f", (flips - last_flips) * 1000.0 / window_ms);
 					last_flips = flips;
 				}
-				sys_log.notice("PS5 CPU: %s", ps5_thread_cpu_report((now - last_cpu) * 1'000'000, 14));
+				sys_log.notice("PS5 CPU: %s", ps5_thread_cpu_report(window_ms * 1'000'000, 14));
 				{
 					const u64 calls = utils::g_ps5_mprotect_calls.exchange(0);
 					const u64 tsc = utils::g_ps5_mprotect_tsc.exchange(0);
 					const u64 bytes = utils::g_ps5_mprotect_bytes.exchange(0);
 					const u64 freq = std::max<u64>(utils::get_tsc_freq(), 1);
-					sys_log.notice("PS5 mprotect: %u calls/s, %u ms/s, %u KiB/s", calls * 1000 / std::max<u64>(now - last_cpu, 1),
-						tsc * 1000 / freq * 1000 / std::max<u64>(now - last_cpu, 1), bytes / 1024 * 1000 / std::max<u64>(now - last_cpu, 1));
+					sys_log.notice("PS5 mprotect: %u calls/s, %u ms/s, %u KiB/s", calls * 1000 / window_ms,
+						tsc * 1000 / freq * 1000 / window_ms, bytes / 1024 * 1000 / window_ms);
 				}
 				// Where the busiest threads spend their time: 2 s of samples every ~8 s, cycling through the top 4
 				// ("sys@addr" = inside libkernel/system code, called from addr)
-- 
