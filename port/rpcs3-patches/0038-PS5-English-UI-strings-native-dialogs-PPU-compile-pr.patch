+namespace
+{
+// Qt's QString::arg for one argument: the lowest-numbered %N marker(s) become the argument
+std::string arg(std::string text, const char* value)
+{
+	if (!value)
+		return text;
+	int lowest = 100;
+	for (usz i = 0; i + 1 < text.size(); i++)
+		if (text[i] == '%' && text[i + 1] >= '0' && text[i + 1] <= '9')
+			lowest = std::min(lowest, text[i + 1] - '0');
+	if (lowest == 100)
+		return text;
+	const std::string marker = {'%', static_cast<char>('0' + lowest)};
+	for (usz at = text.find(marker); at != std::string::npos; at = text.find(marker, at + std::char_traits<char>::length(value)))
+		text.replace(at, 2, value);
+	return text;
+}
