+// UTF-8 to UTF-32 (the native dialogs draw u32 text)
+std::u32string utf8_to_u32(const std::string& text)
+{
+	std::u32string out;
+	for (usz i = 0; i < text.size();)
+	{
+		const u8 c = static_cast<u8>(text[i]);
+		const int extra = c >= 0xf0 ? 3 : c >= 0xe0 ? 2 : c >= 0xc0 ? 1 : 0;
+		char32_t code = extra == 3 ? c & 0x07 : extra == 2 ? c & 0x0f : extra == 1 ? c & 0x1f : c;
+		i++;
+		for (int k = 0; k < extra && i < text.size(); k++, i++)
+			code = (code << 6) | (static_cast<u8>(text[i]) & 0x3f);
+		out.push_back(code);
+	}
+	return out;
+}
