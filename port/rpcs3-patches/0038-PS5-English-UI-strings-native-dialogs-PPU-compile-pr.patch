+// No video decoding on the console: a source that never has a frame. The native interface then shows the
+// still icon. video_view (save lists with ICON1.PAM, game details) ensure()s a source: none at all would
+// abort the emulator the first time a save with an animated icon was listed.
+struct ps5_null_video_source final : video_source
+{
+	void set_iso_path(const std::string&) override {}
+	void set_video_path(const std::string&, bool) override {}
+	void set_audio_path(const std::string&, bool) override {}
+	void set_active(bool active) override { m_active = active; }
+	bool get_active() const override { return m_active; }
+	bool has_new() const override { return false; }
+	void get_image(std::vector<u8>& data, int& w, int& h, int& ch, int& bpp) override
+	{
+		data.clear();
+		w = h = ch = bpp = 0;
+	}
+	bool m_active = false;
+};
