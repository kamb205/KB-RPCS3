+}
 // Per-frame timestamps for the frame-time percentiles in the FPS log line (ps5_gs_frame::flip records here).
 namespace
 {
@@ -896,6 +908,10 @@ void start_watchdog()
 	sigaction(SIGUSR2, &action, nullptr);
 	g_main_heartbeat = now_ms();
 	g_watchdog_run = true;
+	// Load the live tuning file before the first report so the RSX pin and the spin knobs apply to this
+	// game from the start, not after the first 4 s report.
+	rpcs3ps5_tune_refresh();
+	sys_log.notice("PS5 TUNING: %s", rpcs3ps5_tune_describe());
 	g_watchdog = std::thread([]
 	{
 		u64 last_dump = 0;
@@ -932,11 +948,45 @@ void start_watchdog()
 					sys_log.notice("PS5 mprotect: %u calls/s, %u ms/s, %u KiB/s", calls * 1000 / window_ms,
 						tsc * 1000 / freq * 1000 / window_ms, bytes / 1024 * 1000 / window_ms);
 				}
+				// Live tuning (ps5-tuning.txt): re-read it and log when it changed (a benchmark marker).
+				rpcs3ps5_tune_refresh();
+				{
+					static std::string last_tuning = rpcs3ps5_tune_describe();
+					const std::string tuning = rpcs3ps5_tune_describe();
+					if (tuning != last_tuning)
+					{
+						last_tuning = tuning;
+						sys_log.notice("PS5 TUNING: %s", tuning);
+					}
+				}
+				// GPU waits since the last report: calls, spin (ms/s), sleeps, and total wait.
+				{
+					const bool has_radv = &radv_ps5_stat_waits != nullptr;
+					const u64 rw = has_radv ? __atomic_load_n(&radv_ps5_stat_waits, __ATOMIC_RELAXED) : 0;
+					const u64 rs = has_radv ? __atomic_load_n(&radv_ps5_stat_spin_ns, __ATOMIC_RELAXED) : 0;
+					const u64 rsl = has_radv ? __atomic_load_n(&radv_ps5_stat_sleeps, __ATOMIC_RELAXED) : 0;
+					const u64 rwt = has_radv ? __atomic_load_n(&radv_ps5_stat_wait_ns, __ATOMIC_RELAXED) : 0;
+					static u64 lrw = 0, lrs = 0, lrsl = 0, lrwt = 0;
+					u64 vw = 0, vs = 0, vsl = 0;
+					ps5_vk_event_stats(&vw, &vs, &vsl);
+					static u64 lvw = 0, lvs = 0, lvsl = 0;
+					const u64 freq = std::max<u64>(utils::get_tsc_freq(), 1);
+					const u64 radv_spin_ms = (rs - lrs) / 1000000 * 1000 / window_ms;
+					const u64 radv_wait_ms = (rwt - lrwt) / 1000000 * 1000 / window_ms;
+					const u64 vk_spin_ms = (vs - lvs) * 1000 / freq * 1000 / window_ms;
+					sys_log.notice("PS5 WAITS: radv %u/s spin %u ms/s sleeps %u/s wait %u ms/s | vkevent %u/s spin %u ms/s sleeps %u/s",
+						(rw - lrw) * 1000 / window_ms, radv_spin_ms, (rsl - lrsl) * 1000 / window_ms, radv_wait_ms,
+						(vw - lvw) * 1000 / window_ms, vk_spin_ms, (vsl - lvsl) * 1000 / window_ms);
+					lrw = rw; lrs = rs; lrsl = rsl; lrwt = rwt; lvw = vw; lvs = vs; lvsl = vsl;
+				}
 				// Where the busiest threads spend their time: 2 s of samples every ~8 s, cycling through the top 4
 				// ("sys@addr" = inside libkernel/system code, called from addr)
 				if (++cpu_reports % 2 == 0)
 				{
-					const std::string name = ps5_thread_top_name((cpu_reports / 2) % 4);
+					// Every 5th slot is the RSX thread explicitly (affinity/contention experiment); the rest
+					// are the busiest threads.
+					const u64 slot = (cpu_reports / 2) % 5;
+					const std::string name = slot == 4 ? std::string("rsx::thread") : ps5_thread_top_name(slot);
 					if (!name.empty())
 						sys_log.notice("PS5 PROFILE %s: %s", name, ps5_thread_profile(name, 400));
 				}
