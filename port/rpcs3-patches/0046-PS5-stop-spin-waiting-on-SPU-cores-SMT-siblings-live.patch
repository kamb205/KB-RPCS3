 		if (auto manager = g_fxo->try_get<rsx::overlays::display_manager>())
diff --git a/rpcs3/Emu/RSX/VK/vkutils/sync.cpp b/rpcs3/Emu/RSX/VK/vkutils/sync.cpp
index 4041f4fa0..55006e37d 100644
--- a/rpcs3/Emu/RSX/VK/vkutils/sync.cpp
+++ b/rpcs3/Emu/RSX/VK/vkutils/sync.cpp
@@ -12,6 +12,12 @@
 #include "util/asm.hpp"
 #include "util/logs.hpp"
 
+#ifdef __PROSPERO__
+#include <atomic>
+#include <chrono>
+#include <thread>
+#endif
+
 namespace vk
 {
 	namespace globals
@@ -587,6 +593,22 @@ namespace vk
 		}
 	}
 
+#ifdef __PROSPERO__
+	// PS5: live spin/backoff tunables from the title (app/ps5/src/ps5_tuning.c) and counters for the frontend
+	// ("PS5 WAITS", ps5_frontend.cpp). spin_us < 0 = unbounded spin (today's behaviour); 0 = sleep at once.
+	extern "C" int64_t rpcs3ps5_tune(int key);
+	enum { PS5_TUNE_VK_EVENT_SPIN_US = 2, PS5_TUNE_VK_EVENT_SLEEP_US = 3 };
+	static std::atomic<u64> g_ps5_vk_event_waits{0};
+	static std::atomic<u64> g_ps5_vk_event_spin_tsc{0};
+	static std::atomic<u64> g_ps5_vk_event_sleeps{0};
+	extern "C" void ps5_vk_event_stats(uint64_t* waits, uint64_t* spin_tsc, uint64_t* sleeps)
+	{
+		*waits = g_ps5_vk_event_waits.load(std::memory_order_relaxed);
+		*spin_tsc = g_ps5_vk_event_spin_tsc.load(std::memory_order_relaxed);
+		*sleeps = g_ps5_vk_event_sleeps.load(std::memory_order_relaxed);
+	}
+#endif
+
 	VkResult wait_for_event(event* pEvent, u64 timeout)
 	{
 		// Convert timeout to TSC cycles. Timeout accuracy isn't super-important, only fast response when event is signaled (within 10us if possible)
@@ -597,6 +619,23 @@ namespace vk
 			timeout *= (freq / 1'000'000);
 		}
 
+#ifdef __PROSPERO__
+		const int64_t spin_us = rpcs3ps5_tune(PS5_TUNE_VK_EVENT_SPIN_US);
+		const int64_t sleep_us = rpcs3ps5_tune(PS5_TUNE_VK_EVENT_SLEEP_US);
+		const u64 spin_start = freq ? utils::get_tsc() : get_system_time();
+		const u64 spin_ticks = spin_us > 0 ? static_cast<u64>(spin_us) * (freq ? (freq / 1'000'000) : 1) : 0;
+		u64 spins_tsc = 0, sleep_count = 0, prev_t = spin_start;
+		bool waited = false;
+		const auto account = [&]()
+		{
+			if (waited)
+			{
+				g_ps5_vk_event_waits.fetch_add(1, std::memory_order_relaxed);
+				g_ps5_vk_event_spin_tsc.fetch_add(spins_tsc, std::memory_order_relaxed);
+				g_ps5_vk_event_sleeps.fetch_add(sleep_count, std::memory_order_relaxed);
+			}
+		};
+#endif
 		u64 start = 0;
 
 		while (true)
@@ -604,6 +643,9 @@ namespace vk
 			switch (const auto status = pEvent->status())
 			{
 			case VK_EVENT_SET:
+#ifdef __PROSPERO__
+				account();
+#endif
 				return VK_SUCCESS;
 			case VK_EVENT_RESET:
 				break;
@@ -626,11 +668,31 @@ namespace vk
 					(now - start) > timeout)
 				{
 					rsx_log.error("[vulkan] vk::wait_for_event has timed out!");
+#ifdef __PROSPERO__
+					account();
+#endif
 					return VK_TIMEOUT;
 				}
 			}
 
+#ifdef __PROSPERO__
+			waited = true;
+			const u64 now_t = freq ? utils::get_tsc() : get_system_time();
+			const bool can_spin = spin_us < 0 || (now_t >= spin_start && (now_t - spin_start) <= spin_ticks);
+			if (can_spin)
+			{
+				utils::pause();
+				spins_tsc += now_t - prev_t;
+			}
+			else
+			{
+				std::this_thread::sleep_for(std::chrono::microseconds(sleep_us < 1 ? 1 : sleep_us));
+				sleep_count++;
+			}
+			prev_t = now_t;
+#else
 			utils::pause();
+#endif
 		}
 	}
 }
diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
