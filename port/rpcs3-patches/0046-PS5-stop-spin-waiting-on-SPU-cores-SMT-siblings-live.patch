From d74bf2e3371f0260858f3a3390cd52c1b2131e86 Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Thu, 8 Oct 2026 19:31:50 +0100
Subject: [PATCH 46/47] PS5: stop spin-waiting on SPU cores SMT siblings - live
 spin/backoff tunables + counters

Live tuning file /app0/rpcs3/ps5-tuning.txt (app/ps5/src/ps5_tuning.c) drives:
- RADV radv_ps5_queue_wait_seq: spin/sleep times + wait counters
- RPCS3 vk::wait_for_event: spin/sleep + counters
- an optional RSX main-thread CPU pin (Thread.cpp ps5_rsx_main_affinity, RSXThread.cpp)
Defaults equal the behaviour before the experiment (RADV 4ms spin/100us sleep, vk unbounded spin,
no pin), so deleting the file restores it. Frontend logs PS5 TUNING (when it changes) and PS5 WAITS
(per report), and profiles rsx::thread every 5th slot.
---
 Utilities/Thread.cpp              | 46 ++++++++++++++++++++++-
 rpcs3/Emu/RSX/RSXThread.cpp       |  9 +++++
 rpcs3/Emu/RSX/VK/vkutils/sync.cpp | 62 +++++++++++++++++++++++++++++++
 rpcs3/ps5/ps5_frontend.cpp        | 52 +++++++++++++++++++++++++-
 4 files changed, 166 insertions(+), 3 deletions(-)

diff --git a/Utilities/Thread.cpp b/Utilities/Thread.cpp
index 21f72122a..2421672fd 100644
--- a/Utilities/Thread.cpp
+++ b/Utilities/Thread.cpp
@@ -3957,6 +3957,9 @@ void thread_ctrl::detect_cpu_layout()
 // kPs5Sibling: the distance between a core's two CPUs (1: CPUs 0+1, 2+3, ...).
 constexpr u32 kPs5Sibling = 1;
 
+extern "C" int64_t rpcs3ps5_tune(int key); // app/ps5/src/ps5_tuning.c
+enum { PS5_TUNE_RSX_CPU = 4 };
+
 static u64 ps5_affinity_mask(thread_class group, u64 all)
 {
 	u64 firsts = 0, seconds = 0;
@@ -3977,14 +3980,53 @@ static u64 ps5_affinity_mask(thread_class group, u64 all)
 		return true;
 	}();
 	(void)logged;
+	const int64_t rsx_cpu = rpcs3ps5_tune(PS5_TUNE_RSX_CPU);
+
 	switch (group)
 	{
-	case thread_class::spu: return firsts ? firsts : all;
+	case thread_class::spu:
+	{
+		u64 m = firsts ? firsts : all;
+		if (rsx_cpu >= 0 && (m & ~(1ull << rsx_cpu)))
+			m &= ~(1ull << rsx_cpu);
+		return m;
+	}
 	case thread_class::ppu:
-	case thread_class::rsx: return seconds ? seconds : all;
+	{
+		u64 m = seconds ? seconds : all;
+		if (rsx_cpu >= 0 && (m & ~(1ull << rsx_cpu)))
+			m &= ~(1ull << rsx_cpu);
+		return m;
+	}
+	case thread_class::rsx:
+	{
+		u64 m = seconds ? seconds : all;
+		if (rsx_cpu >= 0 && (m & ~(1ull << rsx_cpu)))
+			m &= ~(1ull << rsx_cpu);
+		return m;
+	}
 	default: return all;
 	}
 }
+
+// The RSX MAIN thread's mask: CPU <rsx_cpu> when the tuning file asks for it, else the normal mask. Only the
+// main RSX thread calls this (RSXOffload.cpp keeps get_affinity_mask), so the RSX Offloader never shares it.
+u64 ps5_rsx_main_affinity(u64 fallback)
+{
+	const int64_t rsx_cpu = rpcs3ps5_tune(PS5_TUNE_RSX_CPU);
+
+	if (rsx_cpu >= 0 && rsx_cpu < 64 && (thread_ctrl::get_process_affinity_mask() >> rsx_cpu & 1))
+	{
+		static const bool logged = [rsx_cpu] {
+			sig_log.notice("PS5: rsx::thread pinned to CPU %d", static_cast<int>(rsx_cpu));
+			return true;
+		}();
+		(void)logged;
+		return 1ull << rsx_cpu;
+	}
+
+	return fallback;
+}
 #endif
 
 u64 thread_ctrl::get_affinity_mask(thread_class group)
